generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Vehicle {
  id               String   @id @default(uuid())
  make             String
  model            String
  category         String
  price            Decimal  @db.Decimal(12, 2)
  quantity         Int      @default(0)
  imageUrl         String?  @db.VarChar(2048)
  year             Int?
  odometerKm       Int?
  engineCc         Int?
  powerBhp         Int?
  torqueNm         Int?
  fuelType         String?
  transmission     String?
  drivetrain       String?
  fuelEconomyKmpl  Decimal? @db.Decimal(5, 2)
  color            String?  @db.VarChar(32)
  owners           Int?
  vin              String?  @db.VarChar(17)
  seats            Int?
  rangeKm          Int?
  batteryKwh       Decimal? @db.Decimal(5, 1)
  description      String?  @db.VarChar(600)
  features         String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([make])
  @@index([model])
  @@index([category])
  @@index([price])
  @@index([fuelType])
  @@index([year])
}
