# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Keep false for direct connections. Set to 1 when behind exactly one reverse
# proxy (Render, Vercel); never trust client-supplied X-Forwarded-For directly.
TRUST_PROXY=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/dealership_test

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace-this-with-at-least-32-characters
ADMIN_EMAIL=admin@dealership.local
ADMIN_PASSWORD=replace-this-admin-password

# Auth rate limiting
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
