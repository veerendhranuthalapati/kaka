# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Keep false for direct connections. Set to the exact hop count (e.g., 1) when behind
# exactly that many reverse proxies (Render, Vercel). Never use true; use an IP/subnet
# list only if you know what you are doing. Never trust client-supplied X-Forwarded-For directly.
TRUST_PROXY=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/dealership_test
# Production: use sslmode=require or verify-full unless DATABASE_SSL_OPTOUT=true
DATABASE_SSL_OPTOUT=false

# Auth (JWT_SECRET must be at least 32 characters, high entropy; replace in every deploy)
JWT_SECRET=dev-only-jwt-secret-change-in-production-abcdefgh-99
JWT_ISSUER=autoyard-api
JWT_AUDIENCE=autoyard-client
BCRYPT_COST=12
ADMIN_EMAIL=admin@autoyard.local
ADMIN_PASSWORD=replace-this-admin-password

# Wikimedia Commons fetch script (local only — never commit a real value)
COMMONS_CONTACT=

# Rate limiting (in-memory, single-instance — see docs/SECURITY-DESIGN.md)
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=60
WRITE_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DISABLED=false

# Login failure throttling (in-memory store)
LOGIN_FAIL_MAX_IP_EMAIL=5
LOGIN_FAIL_WINDOW_MS=900000
LOGIN_FAIL_MAX_EMAIL=20
LOGIN_LOCKOUT_MS=900000
LOGIN_STORE_MAX_KEYS=10000

# HTTP server timeouts (ms)
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
